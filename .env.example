# ============================================================
#  HM Social Boost — WooCommerce WhatsApp Agent
#  Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- WooCommerce ---
WC_SITE_URL=https://votre-boutique.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_WEBHOOK_SECRET=votre_secret_webhook_woocommerce

# --- Meta / WhatsApp Cloud API ---
META_PHONE_NUMBER_ID=123456789012345
META_WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_VERIFY_TOKEN=votre_token_verification_webhook_meta

# --- Statuts WooCommerce ---
# Statut appliqué quand le client confirme
WC_STATUS_CONFIRMED=processing
# Statut appliqué quand le client annule
WC_STATUS_CANCELLED=cancelled
# Délai avant annulation automatique si pas de réponse (en heures)
AUTO_CANCEL_HOURS=24

# --- App ---
SECRET_KEY=changez_cette_cle_secrete_en_production
DATABASE_URL=sqlite:///./agent.db
